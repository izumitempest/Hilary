# Database Configuration
DATABASE_URL=sqlite:///./hilary.db
# Example for Postgres:
# DATABASE_URL=postgresql://user:password@localhost/hilary

# Security (Required)
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secure-secret-key-here

# Groq API (Required for text/LLM + vision fallback)
GROQ_API_KEY=your-groq-api-key-here
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Gemini API (Optional, for better vision analysis)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_VISION_MODEL=gemini-1.5-flash
# Set to 'gemini' to use Gemini for vision, 'groq' otherwise
VISION_PROVIDER=groq

# Brevo API (Required for sending verification emails)
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=noreply@mindscape.example.com

# Frontend URL (Required for CORS and email links)
# e.g., http://localhost:5173 for local development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
